[Unit]
Description=WAGE Pi Backend (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wage
WorkingDirectory=/home/wage/wage/pi
ExecStart=/home/wage/wage/pi/.venv/bin/gunicorn backend.main:app \
    --workers 2 \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 0.0.0.0:8000 \
    --timeout 60 \
    --keepalive 5 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --preload
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
