[Unit]
Description=WAGE Pi OLED Service
After=network-online.target wage-pi-backend.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/wage/wage/pi
ExecStart=/home/wage/wage/pi/.venv/bin/python oled/oled_service.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
