[Unit]
Description=WAGE Pi Screen Power Save
After=graphical.target wage-pi-backend.service
Wants=wage-pi-backend.service

[Service]
Type=simple
User=wage
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/wage/.Xauthority
ExecStart=/home/wage/wage/pi/.venv/bin/python3 /home/wage/wage/pi/screen/screen_save.py
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
