[Unit]
Description=WAGE Pi Kiosk (Chromium)
After=graphical.target wage-pi-backend.service
Wants=wage-pi-backend.service

[Service]
Type=simple
User=wage
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/wage/.Xauthority
ExecStart=/home/wage/wage/pi/scripts/kiosk_start.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
